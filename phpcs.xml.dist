<?xml version="1.0"?>
<ruleset name="scheduler">
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>bin</file>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="130"/>
        </properties>
    </rule>
</ruleset>
