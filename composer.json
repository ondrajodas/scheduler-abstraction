{
    "name": "app/scheduler",
    "description": "Abstrakce nad plánovačem úloh a mutexem s vyměnitelnou implementací scheduleru (dnes Laravel, později crunz).",
    "type": "library",
    "license": "proprietary",
    "require": {
        "ext-redis": "*",
        "php": "^8.2",
        "dragonmantank/cron-expression": "^3.4",
        "illuminate/console": "^12.0",
        "illuminate/container": "^12.0",
        "psr/clock": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Examples\\": "examples/"
        }
    },
    "scripts": {
        "tests": "phpunit",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --no-progress",
        "ci": [
            "@phpcs",
            "@phpstan",
            "@tests"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
